# ===== REQUIRED: LLM API Key (Google Gemini) =====
GEMINI_API_KEY= # Get free at aistudio.google.com
GEMINI_MODEL=gemini-2.0-flash                                        # Google Gemini 2.0 Flash
LLM_PROVIDER=gemini                                                   # gemini | groq

# Optional: Groq STT / LLM fallback
GROQ_API_KEY=                                                         # Free at console.groq.com
GROQ_MODEL=openai/gpt-oss-120b

# ===== STT Settings =====
WHISPER_MODEL_SIZE=base                                               # tiny | base | small
WHISPER_DEVICE=cpu                                                    # cpu (no GPU needed)

# ===== TTS Settings =====
TTS_PROVIDER=edge-tts                                                 # edge-tts (ultra-fast neural TTS)
TTS_LANGUAGE=en                                                       # en | es | fr | de | hi | etc.

# ===== Database =====
DB_URL=sqlite+aiosqlite:///./voice_assistant.db

# ===== App Config =====
MAX_HISTORY_MESSAGES=20
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://voice-ai-nifi.onrender.com"]
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
